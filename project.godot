config_version=5

[application]
config/name="Rift Rush"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.03, 0.12, 1)
boot_splash/image="res://splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]
Ads="*res://ads.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
environment/defaults/default_clear_color=Color(0.07, 0.03, 0.14, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
